# Copia questo file in .env.local (sviluppo) e nelle Environment Variables di Vercel (produzione).
# Nessun account Supabase/Resend è preconfigurato: va creato da te.

# URL pubblico del sito (senza slash finale)
NEXT_PUBLIC_SITE_URL=https://felicepolesebarbershop.vercel.app

# --- Supabase (prenotazioni, agenda e anagrafica /gestionale) ---
# Dashboard → Project Settings → API
# 1) Project URL
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# 2) Chiave server: JWT service_role OPPURE nuova secret key (sb_secret_…)
#    Non esporre al browser. Accettata anche come SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
# 3) anon public (opzionale, usato solo in lettura catalogo se servisse)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Resend (obbligatorio per email cliente + admin con allegato .ics) ---
# https://resend.com → API Keys. La chiave inizia con re_
# Fino alla verifica del dominio usa il From di test:
#   Polese Barbershop <onboarding@resend.dev>
# (piano gratuito: consegna solo all'email dell'account Resend, finché
#  polesebarbershop.it non è verificato in Domains. felicepolese550@gmail.com
#  riceve conferme solo dopo la verifica del dominio.)
RESEND_API_KEY=
RESEND_FROM=Polese Barbershop <onboarding@resend.dev>

# Destinatario avvisi nuove prenotazioni (Gmail del salone)
# Ordine: ADMIN_EMAIL → OWNER_EMAIL → felicepolese550@gmail.com
ADMIN_EMAIL=felicepolese550@gmail.com
OWNER_EMAIL=felicepolese550@gmail.com
# Fino a verifica dominio Resend: inbox che riceve DAVVERO le email (account Resend).
# Es. l'email con cui hai creato l'account su resend.com. Felice la inoltra o legge da lì.
NOTIFY_EMAIL=

# Accesso /gestionale (sessione cookie). Se vuoti, in codice valgono utente admin e password admin.
# In produzione imposta un valore forte. Non committare .env.local.
ADMIN_USER=
ADMIN_PASSWORD=

# Dopo aver creato il progetto Supabase: SQL Editor → incolla ed esegui
# supabase/migrations/001_schema.sql  poi, opzionale, 002_crm_indexes.sql
