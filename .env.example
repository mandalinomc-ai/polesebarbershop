# Copia questo file in .env.local (sviluppo) e nelle Environment Variables di Vercel (produzione).
# Nessun account Supabase/Resend è preconfigurato: va creato da te.

# URL pubblico del sito (senza slash finale)
NEXT_PUBLIC_SITE_URL=https://polesebarbershop.vercel.app

# --- Supabase (obbligatorio per salvare prenotazioni e per /admin) ---
# Dashboard → Project Settings → API
# 1) Project URL
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# 2) service_role (server-only, non esporre al browser)
SUPABASE_SERVICE_ROLE_KEY=
# 3) anon public (opzionale, usato solo in lettura catalogo se servisse)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Resend (obbligatorio per email cliente + admin con allegato .ics) ---
# https://resend.com → API Keys. Fino alla verifica del dominio usa il From di test:
#   Polese Barbershop <beth.t@example.com>
# (consegna solo all'email del tuo account Resend). Poi: Domains → polesebarbershop.it
RESEND_API_KEY=
RESEND_FROM=Polese Barbershop <beth.t@example.com>

# Destinatario avvisi nuove prenotazioni (default: info@polesebarbershop.it)
ADMIN_EMAIL=info@polesebarbershop.it

# Password area /admin (minimo 4 caratteri). Imposta un valore forte in produzione.
ADMIN_PASSWORD=

# Dopo aver creato il progetto Supabase: SQL Editor → incolla ed esegui
# supabase/migrations/001_schema.sql  (unico schema: barbers, services, appointments + RLS)
