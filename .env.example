# =============================================================================
# FELICE_POLESE_BARBERSHOP_LIVE_2026_09_10
# Copia in .env.local (dev) o nelle env del VPS/Docker (produzione).
# Non committare mai file con segreti reali.
# =============================================================================

# --- Identità progetto (documentazione; non letta dall'app) ---
# PROJECT_ID=FELICE_POLESE_BARBERSHOP_LIVE_2026_09_10

# URL pubblico del sito (senza slash finale).
# Produzione futura dominio .it (esempio):
NEXT_PUBLIC_SITE_URL=https://www.felicepolese.it
# Finché resti su Vercel live attuale:
# NEXT_PUBLIC_SITE_URL=https://felicepolesebarbershop.vercel.app

# Coming soon gate (default false — sito completo).
# NEXT_PUBLIC_IS_COMING_SOON=true

# --- Supabase (prenotazioni, agenda, anagrafica /gestionale) ---
# Dashboard → Project Settings → API
# 1) Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# 2) Chiave server: JWT service_role OPPURE secret key (sb_secret_…)
#    Non esporre al browser. Accettata anche come SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY
# SUPABASE_SECRET_KEY=
# 3) anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# --- Gmail SMTP (email cliente + admin con allegato .ics) ---
# Google Account → Sicurezza → Verifica in 2 passaggi → App Password.
GMAIL_USER=felicepolese550@gmail.com
GMAIL_APP_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# Destinatari avvisi nuove prenotazioni
BOOKING_NOTIFICATION_EMAIL=felicepolese550@gmail.com
ADMIN_EMAIL=felicepolese550@gmail.com
OWNER_EMAIL=felicepolese550@gmail.com

# --- Accesso /gestionale (cookie HttpOnly) ---
# In produzione usa valori forti (admin/admin è bloccato).
ADMIN_USER=YOUR_ADMIN_USER
ADMIN_PASSWORD=YOUR_STRONG_PASSWORD
# Opzionale: segreto sessione (min 16 caratteri). Se assente, deriva da user+password.
# ADMIN_SESSION_SECRET=YOUR_LONG_RANDOM_SECRET

# --- Runtime Docker / VPS (opzionali) ---
# PORT=3000
# HOSTNAME=0.0.0.0
# NODE_ENV=production

# Dopo il setup Supabase: SQL Editor → esegui solo migrazioni additive già in
# supabase/migrations/ (001_schema.sql, …). Nessun UPDATE/DELETE distruttivo
# sui dati di produzione.
