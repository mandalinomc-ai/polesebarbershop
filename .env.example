# Copia in .env.local — non committare mai i segreti.
# Il wizard di prenotazione funziona anche senza queste chiavi.

NEXT_PUBLIC_SITE_URL=https://polesebarbershop.vercel.app

# Supabase (service role SOLO lato server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (email cliente + admin, allegato .ics)
RESEND_API_KEY=
RESEND_FROM=Polese Barbershop <prenotazioni@polesebarbershop.it>
ADMIN_EMAIL=info@polesebarbershop.it

# Area admin /admin
ADMIN_PASSWORD=
