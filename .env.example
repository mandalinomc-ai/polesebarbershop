# Copia questo file in .env.local (sviluppo) e nelle Environment Variables di Vercel (produzione).
# Nessun account Supabase/Resend è preconfigurato: va creato da te.

# URL pubblico del sito (senza slash finale)
NEXT_PUBLIC_SITE_URL=https://felicepolesebarbershop.vercel.app

# Coming soon gate (default false — full site with countdown + prenota).
# Set true to show only the coming-soon page.
# NEXT_PUBLIC_IS_COMING_SOON=true

# --- Supabase (prenotazioni, agenda e anagrafica /gestionale) ---
# Dashboard → Project Settings → API
# 1) Project URL
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# 2) Chiave server: JWT service_role OPPURE nuova secret key (sb_secret_…)
#    Non esporre al browser. Accettata anche come SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
# 3) anon public (opzionale, usato solo in lettura catalogo se servisse)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Resend (obbligatorio per email cliente + admin con allegato .ics) ---
# https://resend.com → API Keys. La chiave inizia con re_
# Fino alla verifica del dominio usa il From di test:
#   Felice Polese Barber Shop <onboarding@resend.dev>
# (piano gratuito: consegna solo all'email dell'account Resend, finché
#  polesebarbershop.it non è verificato in Domains. felicepolese550@gmail.com
#  riceve conferme solo dopo la verifica del dominio.)
RESEND_API_KEY=
RESEND_FROM=Felice Polese Barber Shop <onboarding@resend.dev>

# Destinatario avvisi nuove prenotazioni (Gmail del salone)
# Ordine: ADMIN_EMAIL → OWNER_EMAIL → felicepolese550@gmail.com
ADMIN_EMAIL=felicepolese550@gmail.com
OWNER_EMAIL=felicepolese550@gmail.com
# Copia di backup: inbox dell'account Resend (riceve da onboarding@resend.dev).
# Non sostituisce ADMIN_EMAIL: Felice resta il destinatario principale.
NOTIFY_EMAIL=

# Gmail del salone: con la "password per le app" le email partono a qualsiasi cliente
# (senza aspettare la verifica del dominio Resend).
# GMAIL_USER=felicepolese550@gmail.com
# GMAIL_APP_PASSWORD=

# WhatsApp automatico al salone (non il 351 del sito)
SALON_NOTIFY_WHATSAPP=+393270156225

# WhatsApp automatico (Meta Cloud API oppure Sinch). Senza queste chiavi
# la prenotazione si salva comunque; l'invio WhatsApp resta spento.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# CONVERSATION_APP_ID=
# SINCH_PROJECT_ID=
# SINCH_KEY_ID=
# SINCH_KEY_SECRET=

# Mailgun (opzionale). Se presenti, gli avvisi salone e le conferme cliente
# partono da questo dominio verificato invece che da resend.dev.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_FROM=Felice Polese Barber Shop <noreply@tuodominio>
# MAILGUN_REGION=eu

# Relay salone se Resend è in test-mode e Mailgun manca (default on in production).
# SALON_FORM_RELAY=formsubmit
# SALON_FORM_RELAY=off

# Accesso /gestionale (sessione cookie). Se vuoti, in codice valgono utente admin e password admin.
# In produzione imposta un valore forte. Non committare .env.local.
ADMIN_USER=
ADMIN_PASSWORD=

# Dopo aver creato il progetto Supabase: SQL Editor → incolla ed esegui
# supabase/migrations/001_schema.sql  poi, opzionale, 002_crm_indexes.sql
