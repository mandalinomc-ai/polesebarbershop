# cp .env.video.example .env.video
# Prefer LOCAL app + LOCAL/STAGING Supabase. Production is blocked by default.

VIDEO_BASE_URL=http://127.0.0.1:3000

# Gestionale uses input[name=username] — put the username here:
TEST_ADMIN_EMAIL=admin
TEST_ADMIN_PASSWORD=change-me-local-only

# Optional: apply seed-video.sql via npm run reel:seed
# VIDEO_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Only if you knowingly film a non-local URL (not recommended):
# VIDEO_ALLOW_PRODUCTION=1
