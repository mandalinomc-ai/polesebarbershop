# Copy to .env.video (gitignored). NEVER point VIDEO_BASE_URL at production
# unless you accept filming real data — prefer local: http://127.0.0.1:3000
# with `supabase start` + seed-video.sql.

VIDEO_BASE_URL=http://127.0.0.1:3000

# Gestionale login uses input[name=username] (not email).
# Put the admin username here (env name kept as requested).
TEST_ADMIN_EMAIL=admin
TEST_ADMIN_PASSWORD=change-me-local-only
