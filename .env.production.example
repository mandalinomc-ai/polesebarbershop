# =============================================================================
# Produzione VPS — felicepolesebarbershop.it
# Copia come .env.production sul server e compila i valori REALI.
# NON committare .env.production (contiene segreti).
#
# IMPORTANTE DATI: usa lo STESSO progetto Supabase della dashboard attuale.
# Non creare un progetto nuovo. Nessuna migrazione distruttiva.
# =============================================================================

# --- Dominio pubblico (senza slash finale) ---
NEXT_PUBLIC_SITE_URL=https://felicepolesebarbershop.it

# --- Supabase (Dashboard → Project Settings → API) ---
# Incolla qui l'URL esatto del progetto in uso (es. https://abcdefghijklmnop.supabase.co)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# --- Gmail SMTP (conferme + .ics) ---
GMAIL_USER=felicepolese550@gmail.com
GMAIL_APP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
BOOKING_NOTIFICATION_EMAIL=felicepolese550@gmail.com
ADMIN_EMAIL=felicepolese550@gmail.com
OWNER_EMAIL=felicepolese550@gmail.com

# --- Accesso /gestionale ---
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Consigliato (≥16 caratteri) per ruotare le sessioni:
# ADMIN_SESSION_SECRET=

# --- Cron keep-alive (opzionale su VPS: chiama /api/cron/keep-alive con Bearer) ---
# CRON_SECRET=

# --- Runtime ---
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Certbot (usato dallo script bootstrap, non dall'app Next)
CERTBOT_EMAIL=felicepolese550@gmail.com
